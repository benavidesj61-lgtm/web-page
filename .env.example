# Copy this file to .env and fill in the values. Never commit .env.
# Production values are set in Netlify: Site configuration → Environment variables.

# Public (reaches the browser on purpose): Cloudflare Turnstile site key.
# Local development can use Cloudflare's documented test key that always passes.
PUBLIC_TURNSTILE_SITE_KEY=

# Server-only secrets (read by the Netlify Function). Never give them the PUBLIC_ prefix.
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=

# Server-only settings for contact emails.
# CONTACT_TO_EMAIL defaults to the address in src/data/site.ts.
CONTACT_TO_EMAIL=
# Must use a domain verified in Resend (e.g. "LE SCENT <contacto@lescent.com.sv>").
CONTACT_FROM_EMAIL=
