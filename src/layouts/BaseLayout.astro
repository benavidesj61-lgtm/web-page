---
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SEO, { type SEOProps } from '@/components/layout/SEO.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import { SITE } from '@/data/site';
// Bundled into the external stylesheet (no inline @font-face), which keeps style-src strict.
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/playfair-display/wght.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '@/styles/global.css';

type Props = SEOProps;

const seo = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a0a0a" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <SEO {...seo} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink />
    <Header />
    <main id="contenido" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />

    <script>
      import { initReveal, updateCurrentYear } from '../scripts/reveal';
      initReveal();
      updateCurrentYear();
    </script>
  </body>
</html>
