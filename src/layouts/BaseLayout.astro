---
import { Font } from 'astro:assets';
import Footer from '@/components/layout/Footer.astro';
import Header from '@/components/layout/Header.astro';
import SEO, { type SeoProps } from '@/components/layout/SEO.astro';
import SkipLink from '@/components/layout/SkipLink.astro';
import { SITE } from '@/config/site';
import '@/styles/global.css';

type Props = SeoProps;

const seo = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Enables reveal-on-scroll styles only when JS runs, so content is never hidden without it. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <Font cssVariable="--font-inter" preload />
    <Font cssVariable="--font-playfair" />
    <SEO {...seo} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0B2545" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SkipLink />
    <Header />
    <main id="contenido" tabindex="-1" class="flex-1 focus:outline-none">
      <slot />
    </main>
    <Footer />
    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>
