---
import Icon from './Icon.astro';

export interface AccordionItem {
  question: string;
  answer: string;
}

interface Props {
  items: readonly AccordionItem[];
  /** Heading level used for each question, to keep the document outline correct. */
  headingLevel?: 'h3' | 'h4';
}

const { items, headingLevel: Heading = 'h3' } = Astro.props;
---

<!-- Native <details>/<summary> is keyboard and screen-reader accessible without ARIA or JS. -->
<div class="divide-y divide-stone border-y border-stone">
  {items.map((item) => (
    <details class="group">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-2 py-3 text-left hover:text-navy-700 [&::-webkit-details-marker]:hidden">
        <Heading class="font-sans text-lg font-semibold text-navy-900">{item.question}</Heading>
        <Icon
          name="chevron-down"
          class="size-2.5 text-gold-700 transition-transform duration-200 ease-out group-open:rotate-180"
        />
      </summary>
      <div class="pb-3 text-taupe">
        <p class="max-w-[65ch]">{item.answer}</p>
      </div>
    </details>
  ))}
</div>
