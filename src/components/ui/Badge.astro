---
export type BadgeVariant = 'new' | 'sale' | 'soldout' | 'neutral';

interface Props {
  variant?: BadgeVariant;
  class?: string;
}

const { variant = 'neutral', class: className } = Astro.props;

const VARIANTS: Record<BadgeVariant, string> = {
  new: 'bg-navy-900 text-white',
  sale: 'bg-gold-500 text-navy-950',
  soldout: 'bg-white text-ink ring-1 ring-stone',
  neutral: 'bg-sand text-taupe',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-sm px-1 py-0.5 text-xs font-semibold tracking-wider uppercase',
    VARIANTS[variant],
    className,
  ]}
>
  <slot />
</span>
