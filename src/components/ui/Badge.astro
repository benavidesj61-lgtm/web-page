---
export type BadgeVariant = 'new' | 'sale' | 'soldout' | 'neutral';

interface Props {
  variant?: BadgeVariant;
  class?: string;
}

const { variant = 'neutral', class: className } = Astro.props;

const VARIANTS: Record<BadgeVariant, string> = {
  new: 'bg-white text-noir-950 border border-noir-950',
  sale: 'bg-noir-950 text-white border border-noir-950',
  soldout: 'bg-noir-200 text-noir-800 border border-noir-200',
  neutral: 'bg-noir-50 text-noir-700 border border-noir-200',
};
---

<span
  class:list={[
    'inline-flex items-center rounded-xs px-1 py-0.5 text-[0.6875rem] leading-none font-semibold tracking-[0.16em] uppercase',
    VARIANTS[variant],
    className,
  ]}
>
  <slot />
</span>
