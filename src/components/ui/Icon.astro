export type IconName = keyof typeof STROKE_ICONS | keyof typeof FILL_ICONS;

interface Props {
  name: IconName;
  class?: string;
  /** Provide only when the icon carries meaning on its own (no visible text next to it). */
  label?: string;
}

const { name, class: className = 'size-2.5', label } = Astro.props;
const isFill = name in FILL_ICONS;
const markup = isFill
  ? FILL_ICONS[name as keyof typeof FILL_ICONS]
  : STROKE_ICONS[name as keyof typeof STROKE_ICONS];
const a11yProps = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class:list={['shrink-0', className]}
  fill={isFill ? 'currentColor' : 'none'}
  stroke={isFill ? 'none' : 'currentColor'}
  stroke-width={isFill ? undefined : 1.75}
  stroke-linecap={isFill ? undefined : 'round'}
  stroke-linejoin={isFill ? undefined : 'round'}
  focusable="false"
  {...a11yProps}
  set:html={markup}
/>
