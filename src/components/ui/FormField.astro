---
import type { HTMLAttributes } from 'astro/types';

export interface SelectOptionGroup {
  label: string;
  options: readonly { value: string; label: string }[];
}

interface Props {
  id: string;
  name: string;
  label: string;
  type?: 'text' | 'email' | 'tel' | 'textarea' | 'select';
  required?: boolean;
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  inputmode?: HTMLAttributes<'input'>['inputmode'];
  placeholder?: string;
  hint?: string;
  /** Select only: first, empty option label. */
  emptyOption?: string;
  groups?: readonly SelectOptionGroup[];
  maxlength?: number;
  class?: string;
}

const {
  id,
  name,
  label,
  type = 'text',
  required = false,
  autocomplete,
  inputmode,
  placeholder,
  hint,
  emptyOption,
  groups = [],
  maxlength,
  class: className,
} = Astro.props;

const hintId = hint ? `${id}-ayuda` : undefined;
const errorId = `${id}-error`;
const describedBy = [hintId, errorId].filter(Boolean).join(' ');
const controlClass =
  'mt-0.5 block w-full rounded-xs border border-noir-400 bg-white px-2 text-base text-noir-950 placeholder:text-noir-500 hover:border-noir-700 focus-visible:border-noir-950 aria-invalid:border-danger aria-invalid:outline-danger disabled:cursor-not-allowed disabled:bg-noir-100 disabled:text-noir-500';
---

<div class={className} data-field={name}>
  <label for={id} class="text-sm font-medium text-noir-950">
    {label}
    {required ? (
      <span class="ml-0.5 text-danger" aria-hidden="true">
        *
      </span>
    ) : (
      <span class="ml-0.5 font-normal text-noir-500">(opcional)</span>
    )}
  </label>

  {type === 'textarea' ? (
    <textarea
      id={id}
      name={name}
      rows="5"
      required={required}
      placeholder={placeholder}
      maxlength={maxlength}
      aria-describedby={describedBy}
      class:list={[controlClass, 'min-h-15 py-1.5']}
    />
  ) : type === 'select' ? (
    <select
      id={id}
      name={name}
      required={required}
      aria-describedby={describedBy}
      class:list={[controlClass, 'min-h-6']}
    >
      {emptyOption && <option value="">{emptyOption}</option>}
      {groups.map((group) => (
        <optgroup label={group.label}>
          {group.options.map((option) => (
            <option value={option.value}>{option.label}</option>
          ))}
        </optgroup>
      ))}
    </select>
  ) : (
    <input
      id={id}
      name={name}
      type={type}
      required={required}
      autocomplete={autocomplete}
      inputmode={inputmode}
      placeholder={placeholder}
      maxlength={maxlength}
      aria-describedby={describedBy}
      class:list={[controlClass, 'min-h-6']}
    />
  )}

  {hint && (
    <p id={hintId} class="mt-0.5 text-sm text-noir-500">
      {hint}
    </p>
  )}
  <p
    id={errorId}
    class="mt-0.5 flex gap-0.5 text-sm font-medium text-danger empty:hidden"
    data-error
  ></p>
</div>
