---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'accent' | 'outline' | 'outline-light' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

type Props = {
  variant?: Variant;
  size?: Size;
  href?: string;
  external?: boolean;
  fullWidth?: boolean;
  disabled?: boolean;
  type?: 'button' | 'submit' | 'reset';
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'type' | 'class' | 'disabled'>;

const {
  variant = 'primary',
  size = 'md',
  href,
  external = false,
  fullWidth = false,
  disabled = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const VARIANTS: Record<Variant, string> = {
  primary: 'bg-navy-900 text-white hover:bg-navy-800 active:bg-navy-950',
  accent: 'bg-gold-500 text-navy-950 hover:bg-gold-400 active:bg-gold-600',
  outline:
    'border border-navy-900 text-navy-900 hover:bg-navy-900 hover:text-white active:bg-navy-950',
  'outline-light':
    'border border-white/70 text-white hover:bg-white hover:text-navy-900 active:bg-navy-100',
  ghost: 'text-navy-900 underline-offset-4 hover:underline active:text-navy-700',
};

const SIZES: Record<Size, string> = {
  sm: 'min-h-5 gap-1 px-2 text-sm',
  md: 'min-h-6 gap-1 px-3 text-base',
  lg: 'min-h-7 gap-1.5 px-4 text-base',
};

const classes = [
  'group inline-flex items-center justify-center rounded-md font-semibold tracking-wide',
  'transition-transform duration-150 ease-out active:scale-[0.98]',
  'aria-disabled:pointer-events-none aria-disabled:opacity-50',
  'disabled:cursor-not-allowed disabled:opacity-50 disabled:active:scale-100',
  VARIANTS[variant],
  SIZES[size],
  fullWidth && 'w-full',
  className,
];

const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

{href && !disabled ? (
  <a href={href} class:list={classes} {...externalProps} {...rest}>
    <slot />
  </a>
) : href ? (
  <a role="link" aria-disabled="true" class:list={classes} {...rest}>
    <slot />
  </a>
) : (
  <button type={type} disabled={disabled} class:list={classes} {...rest}>
    <slot />
  </button>
)}
