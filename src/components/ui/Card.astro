---
import type { HTMLAttributes, HTMLTag } from 'astro/types';

type Props = {
  as?: HTMLTag;
  /** Adds the hover shadow and the focus ring used by cards with a stretched link. */
  interactive?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'article'>, 'class'>;

const { as: Tag = 'article', interactive = false, class: className, ...rest } = Astro.props;
---

<Tag
  class:list={[
    'relative flex flex-col rounded-lg bg-white shadow-card',
    // Shadow is faded in through a pseudo-element so only opacity is animated.
    interactive && [
      'group after:pointer-events-none after:absolute after:inset-0 after:rounded-lg after:opacity-0 after:shadow-card-hover after:transition-opacity after:duration-300 after:ease-out hover:after:opacity-100',
      'has-[a:focus-visible]:outline-3 has-[a:focus-visible]:outline-offset-3 has-[a:focus-visible]:outline-navy-700',
    ],
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
