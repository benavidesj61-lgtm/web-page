---
import type { HTMLAttributes } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'article'>, 'class'> {
  /** Adds the hover elevation; the stretched link inside the card makes it clickable. */
  interactive?: boolean;
  class?: string;
}

const { interactive = false, class: className, ...rest } = Astro.props;
---

<article
  class:list={[
    'relative flex flex-col bg-white',
    // The hover shadow lives on a pseudo-element so only its opacity animates (no box-shadow repaint).
    interactive &&
      'group after:pointer-events-none after:absolute after:inset-0 after:opacity-0 after:shadow-card-hover after:transition-opacity after:duration-300 after:ease-out hover:after:opacity-100 has-focus-visible:after:opacity-100',
    className,
  ]}
  {...rest}
>
  <slot />
</article>
