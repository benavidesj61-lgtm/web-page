---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import { CATEGORY_LIST } from '@/data/categories';
import { CONTACT } from '@/data/site';
import { CONTACT_FORM, CONTACT_LIMITS } from '@/lib/schemas/contact';
import { buildMailtoHref, PHONE_HREF } from '@/utils/contact';
import { getProducts } from '@/utils/products';
import Button from '../ui/Button.astro';
import FormField, { type SelectOptionGroup } from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';

const products = await getProducts();
const productGroups: SelectOptionGroup[] = CATEGORY_LIST.map((category) => ({
  label: category.name,
  options: products
    .filter((product) => product.data.categoria === category.slug)
    .sort((a, b) => a.data.nombre.localeCompare(b.data.nombre, 'es'))
    // Only the slug travels; the server looks up the real name in the catalog.
    .map((product) => ({ value: product.data.slug, label: product.data.nombre })),
})).filter((group) => group.options.length > 0);
---

<div class="border border-noir-100 bg-white p-3 sm:p-4">
  <h2 class="text-3xl">Solicite información o una cotización</h2>
  <p class="mt-1 text-noir-600">
    Complete el formulario y un asesor le responderá en un plazo máximo de un día hábil. Los campos
    marcados con{' '}
    <span class="text-danger" aria-hidden="true">
      *
    </span>
    <span class="sr-only">asterisco</span> son obligatorios.
  </p>

  <div
    class="mt-3 border border-danger bg-white p-2 text-danger"
    role="alert"
    tabindex="-1"
    hidden
    data-form-error
  >
    <p class="flex items-center gap-1 font-semibold">
      <Icon name="alert" class="size-2" />
      No pudimos enviar su mensaje.
    </p>
    <p class="mt-0.5 text-sm text-noir-800" data-form-error-message>
      Revise su conexión e inténtelo de nuevo.
    </p>
    <p class="mt-0.5 text-sm text-noir-800">
      También puede comunicarse directamente al{' '}
      <a href={PHONE_HREF} class="font-semibold underline underline-offset-4">
        {CONTACT.phone.display}
      </a>{' '}
      o a{' '}
      <a href={buildMailtoHref()} class="font-semibold break-all underline underline-offset-4">
        {CONTACT.email}
      </a>
      .
    </p>
  </div>

  <noscript>
    <p class="mt-3 border border-noir-300 bg-noir-50 p-2 text-noir-800">
      Para enviar el formulario necesitamos JavaScript (lo usamos para la verificación antispam).
      Puede escribirnos a{' '}
      <a href={buildMailtoHref()} class="font-semibold underline">
        {CONTACT.email}
      </a>
      o llamarnos al{' '}
      <a href={PHONE_HREF} class="font-semibold underline">
        {CONTACT.phone.display}
      </a>
      .
    </p>
  </noscript>

  <!-- Sent with fetch to the Netlify Function; it has no action, so it never posts without JS. -->
  <form
    class="mt-3 grid gap-2 sm:grid-cols-2 [@media(scripting:none)]:hidden"
    novalidate
    data-contact-form
    data-endpoint={CONTACT_FORM.endpoint}
  >
    <!-- Honeypot: invisible to people, tempting for bots. Filled in = spam. -->
    <div class="absolute -left-[9999px] size-px overflow-hidden" aria-hidden="true">
      <label>
        No llene este campo si es humano
        <input
          type="text"
          name={CONTACT_FORM.honeypotField}
          tabindex="-1"
          autocomplete="off"
          maxlength="200"
        />
      </label>
    </div>

    <FormField
      id="contacto-nombre"
      name="nombre"
      label="Nombre completo"
      required
      autocomplete="name"
      maxlength={CONTACT_LIMITS.nombre.max}
    />
    <FormField
      id="contacto-correo"
      name="correo"
      label="Correo electrónico"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="nombre@empresa.com"
      maxlength={CONTACT_LIMITS.correo.max}
    />
    <FormField
      id="contacto-telefono"
      name="telefono"
      label="Teléfono"
      type="tel"
      required
      autocomplete="tel"
      inputmode="tel"
      placeholder="7529-2926"
      maxlength={CONTACT_LIMITS.telefono.max}
    />
    <FormField
      id="contacto-producto"
      name="producto"
      label="Producto de interés"
      type="select"
      emptyOption="Ninguno en particular"
      groups={productGroups}
    />
    <FormField
      id="contacto-mensaje"
      name="mensaje"
      label="Mensaje"
      type="textarea"
      required
      maxlength={CONTACT_LIMITS.mensaje.max}
      hint="Cuéntenos qué necesita: cantidad aproximada, presentación (sellado o decant) y fecha de entrega."
      class="sm:col-span-2"
    />

    <div class="sm:col-span-2" data-field="turnstile">
      <p class="text-sm font-medium text-noir-950" id="contacto-verificacion">
        Verificación de seguridad
      </p>
      <!-- Cloudflare Turnstile renders here; it checks for bots without puzzles in most cases. -->
      <div
        class="mt-0.5 min-h-[65px]"
        aria-describedby="contacto-verificacion"
        data-turnstile
        data-sitekey={PUBLIC_TURNSTILE_SITE_KEY}
        data-action={CONTACT_FORM.turnstileAction}
      ></div>
      <p class="mt-0.5 flex gap-0.5 text-sm font-medium text-danger empty:hidden" data-error></p>
    </div>

    <div class="flex flex-col gap-2 sm:col-span-2 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-noir-500">Usamos sus datos solo para responder a su solicitud.</p>
      <Button type="submit" size="lg" class="w-full sm:w-auto" data-submit>
        <span data-submit-label>Enviar solicitud</span>
        <span data-submit-icon>
          <Icon name="send" class="size-2" />
        </span>
      </Button>
    </div>
    <p class="sr-only" role="status" aria-live="polite" data-form-status></p>
  </form>
</div>

<script>
  import { initContactForm } from '../../scripts/contact-form';
  initContactForm();
</script>
