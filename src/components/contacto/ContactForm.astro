---
import { buildWhatsAppUrl } from '@/utils/whatsapp';
import Button from '../ui/Button.astro';
import FormField from '../ui/FormField.astro';
import Icon from '../ui/Icon.astro';

const INQUIRY_TYPES = [
  'Compra personal',
  'Regalo corporativo',
  'Pedido por volumen',
  'Otra consulta',
];
---

<div class="rounded-lg bg-white p-3 shadow-card sm:p-4">
  <h2 class="text-2xl">Envíenos un mensaje</h2>
  <p class="mt-1 text-taupe">
    Complete el formulario y lo abriremos en WhatsApp con sus datos listos para enviar. Los campos
    obligatorios están marcados con un asterisco (*).
  </p>

  <div
    class="mt-3 rounded-md border border-danger bg-danger/5 p-2 text-danger"
    role="alert"
    tabindex="-1"
    hidden
    data-error-summary
  >
    <p class="font-semibold">Revise los siguientes campos:</p>
    <ul class="mt-1 list-disc space-y-0.5 pl-3 text-sm"></ul>
  </div>

  <div
    class="mt-3 rounded-md border border-success bg-success/5 p-2 text-success"
    role="status"
    tabindex="-1"
    hidden
    data-form-success
  >
    <p class="flex items-center gap-1 font-semibold">
      <Icon name="check" class="size-2" />
      ¡Listo! Abrimos WhatsApp con su mensaje.
    </p>
    <p class="mt-0.5 text-sm">
      Si no se abrió automáticamente,
      <a
        href={buildWhatsAppUrl()}
        target="_blank"
        rel="noopener noreferrer"
        class="font-semibold underline underline-offset-4"
      >
        presione aquí para enviarlo
      </a>
      .
    </p>
  </div>

  <noscript>
    <p class="mt-3 rounded-md bg-sand p-2 text-sm text-ink">
      Para enviar el formulario active JavaScript, o escríbanos directamente por WhatsApp o correo
      con los datos de contacto de esta página.
    </p>
  </noscript>

  <form class="mt-3 grid gap-2 sm:grid-cols-2" novalidate data-contact-form>
    <FormField
      id="contacto-nombre"
      name="nombre"
      label="Nombre completo"
      required
      autocomplete="name"
    />
    <FormField
      id="contacto-correo"
      name="correo"
      label="Correo electrónico"
      type="email"
      required
      autocomplete="email"
      inputmode="email"
      placeholder="nombre@empresa.com"
    />
    <FormField
      id="contacto-telefono"
      name="telefono"
      label="Teléfono"
      type="tel"
      required
      autocomplete="tel"
      inputmode="tel"
      placeholder="7529-2926"
    />
    <FormField
      id="contacto-tipo"
      name="tipo"
      label="Tipo de consulta"
      type="select"
      options={INQUIRY_TYPES}
    />
    <FormField
      id="contacto-mensaje"
      name="mensaje"
      label="Mensaje"
      type="textarea"
      required
      hint="Cuéntenos qué fragancia busca, para quién es o cuántas unidades necesita."
      class="sm:col-span-2"
    />
    <div class="sm:col-span-2">
      <Button type="submit" variant="accent" size="lg" class="w-full sm:w-auto">
        <Icon name="whatsapp" class="size-2.5" />
        Enviar por WhatsApp
      </Button>
    </div>
  </form>
</div>

<script>
  import { initContactForm } from '../../scripts/contact-form';
  initContactForm();
</script>
