---
import { CATEGORY_LIST } from '@/data/categories';
import { MAX_QUERY_LENGTH, SORT_OPTIONS } from '@/scripts/catalog-filters';
import Icon from '../ui/Icon.astro';

interface Props {
  total: number;
}

const { total } = Astro.props;
const controlClass =
  'min-h-6 w-full rounded-xs border border-noir-400 bg-white px-2 text-base text-noir-950 hover:border-noir-700 focus-visible:border-noir-950';
const chipClass =
  'inline-flex min-h-5 cursor-pointer items-center rounded-full border border-noir-300 px-2 text-sm text-noir-700 hover:border-noir-950 hover:text-noir-950 has-checked:border-noir-950 has-checked:bg-noir-950 has-checked:text-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-noir-950';
---

<!-- Hidden without JavaScript: filtering is client-side, and every product is listed anyway. -->
<form
  class="border-b border-noir-100 pb-3 [@media(scripting:none)]:hidden"
  role="search"
  aria-label="Filtrar catálogo"
  data-filters
>
  <div class="grid gap-2 md:grid-cols-12 md:items-end">
    <div class="md:col-span-6 lg:col-span-7">
      <label for="catalogo-busqueda" class="text-sm font-medium text-noir-950">
        Buscar por nombre o marca
      </label>
      <div class="relative mt-0.5">
        <Icon
          name="search"
          class="pointer-events-none absolute top-1/2 left-1.5 size-2.5 -translate-y-1/2 text-noir-500"
        />
        <input
          id="catalogo-busqueda"
          type="search"
          name="q"
          autocomplete="off"
          maxlength={MAX_QUERY_LENGTH}
          enterkeyhint="search"
          placeholder="Ej. Khamrah, Chanel, vainilla…"
          class:list={[controlClass, 'pl-5']}
          data-filter-search
        />
      </div>
    </div>
    <div class="md:col-span-4 lg:col-span-3">
      <label for="catalogo-orden" class="text-sm font-medium text-noir-950">
        Ordenar por
      </label>
      <select
        id="catalogo-orden"
        name="orden"
        class:list={[controlClass, 'mt-0.5']}
        data-filter-sort
      >
        {SORT_OPTIONS.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    </div>
    <div class="md:col-span-2">
      <button
        type="reset"
        class="min-h-6 w-full rounded-xs px-1 text-sm font-medium text-noir-950 underline underline-offset-4 hover:decoration-2 disabled:cursor-not-allowed disabled:text-noir-500 disabled:no-underline"
        data-filters-reset
        disabled
      >
        Limpiar filtros
      </button>
    </div>
  </div>

  <fieldset class="mt-2">
    <legend class="text-sm font-medium text-noir-950">Categoría</legend>
    <div class="mt-1 flex flex-wrap gap-1">
      <label class={chipClass}>
        <input
          type="radio"
          name="categoria"
          value=""
          class="sr-only"
          checked
          data-filter-category
        />
        Todas
      </label>
      {CATEGORY_LIST.map((category) => (
        <label class={chipClass}>
          <input
            type="radio"
            name="categoria"
            value={category.slug}
            class="sr-only"
            data-filter-category
          />
          {category.name}
        </label>
      ))}
    </div>
  </fieldset>
</form>

<p class="mt-2 text-sm text-noir-600">
  <span role="status" aria-live="polite" data-results-status>
    {total} {total === 1 ? 'producto' : 'productos'} en el catálogo
  </span>
</p>
