---
import { Picture } from 'astro:assets';
import { CATEGORIES } from '@/data/categories';
import { getProductBadges, getProductUrl, type Product } from '@/utils/products';
import { normalizeSearchText } from '@/utils/search';
import Badge from '../ui/Badge.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import ProductPrice from './ProductPrice.astro';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
}

const { product, headingLevel: Heading = 'h3' } = Astro.props;
const { data } = product;
const [cover] = data.imagenes;
const url = getProductUrl(product);
const badges = getProductBadges(product);
const category = CATEGORIES[data.categoria];

// Matches the grid: 1 col < 768px, 2 cols, 3 cols ≥ 1024px, 4 cols ≥ 1280px (max container 1280px).
const SIZES =
  '(min-width: 1280px) 296px, (min-width: 1024px) calc((100vw - 112px) / 3), (min-width: 768px) calc((100vw - 72px) / 2), calc(100vw - 32px)';
---

<Card
  interactive
  class="h-full"
  data-product
  data-category={data.categoria}
  data-search={normalizeSearchText(
    [data.nombre, data.marca, category.name, ...(data.etiquetas ?? [])].join(' '),
  )}
  data-price={data.precio}
  data-date={data.fechaPublicacion.getTime()}
  data-name={normalizeSearchText(data.nombre)}
>
  <div class="relative overflow-hidden rounded-t-lg bg-sand">
    {cover && (
      <Picture
        src={cover.src}
        alt={cover.alt}
        formats={['avif', 'webp']}
        widths={[320, 480, 640, 800]}
        sizes={SIZES}
        width={800}
        height={1000}
        fit="cover"
        position="center"
        loading="lazy"
        decoding="async"
        class="aspect-4/5 h-auto w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
      />
    )}
    {badges.length > 0 && (
      <ul class="absolute top-2 left-2 flex flex-wrap gap-1" aria-label="Estado del producto">
        {badges.map((badge) => (
          <li>
            <Badge variant={badge.variant}>{badge.label}</Badge>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class="flex flex-1 flex-col p-2 sm:p-3">
    <p class="text-xs font-semibold tracking-widest text-gold-700 uppercase">{category.name}</p>
    <Heading class="mt-1 font-sans text-lg leading-snug font-semibold text-navy-900">
      <!-- Stretched link: the whole card is clickable while keeping a single, named link. -->
      <a
        href={url}
        class="after:absolute after:inset-0 after:z-10 hover:text-navy-700 focus-visible:outline-none"
      >
        {data.nombre}
      </a>
    </Heading>
    <div class="mt-auto flex flex-wrap items-end justify-between gap-1 pt-2">
      <ProductPrice price={data.precio} previousPrice={data.precioAnterior} />
      <span
        class="inline-flex items-center gap-0.5 text-sm font-semibold whitespace-nowrap text-navy-900"
        aria-hidden="true"
      >
        Ver detalle
        <Icon
          name="arrow-right"
          class="size-2 transition-transform duration-200 ease-out group-hover:translate-x-0.5"
        />
      </span>
    </div>
  </div>
</Card>
