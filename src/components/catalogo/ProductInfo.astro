---
import { CATEGORIES } from '@/data/categories';
import { formatPrice } from '@/utils/price';
import { getProductBadges, getProductUrl, type Product } from '@/utils/products';
import { absoluteUrl } from '@/utils/url';
import { buildProductInquiryMessage, buildWhatsAppUrl } from '@/utils/whatsapp';
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ProductPrice from './ProductPrice.astro';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { data } = product;
const category = CATEGORIES[data.categoria];
const badges = getProductBadges(product);
const whatsappUrl = buildWhatsAppUrl(
  buildProductInquiryMessage({
    name: data.nombre,
    url: absoluteUrl(getProductUrl(product)),
    price: formatPrice(data.precio),
  }),
);

const assurances = [
  { icon: 'shield-check', text: 'Producto original con comprobante' },
  { icon: 'truck', text: 'Entrega en 24 h en el Gran San Salvador' },
  { icon: 'gift', text: 'Empaque de regalo disponible' },
] as const;
---

<div>
  <div class="flex flex-wrap items-center gap-1">
    <a
      href={`/catalogo/?categoria=${category.slug}`}
      class="text-sm font-semibold tracking-widest text-gold-700 uppercase underline-offset-4 hover:underline"
    >
      {category.name}
    </a>
    {badges.map((badge) => (
      <Badge variant={badge.variant}>{badge.label}</Badge>
    ))}
  </div>

  <h1 class="mt-2 text-4xl">{data.nombre}</h1>
  {data.marca && <p class="mt-1 text-lg text-taupe">{data.marca}</p>}

  <div class="mt-3">
    <ProductPrice price={data.precio} previousPrice={data.precioAnterior} size="lg" />
  </div>

  <p
    class:list={[
      'mt-2 inline-flex items-center gap-1 text-sm font-semibold',
      data.disponible ? 'text-success' : 'text-danger',
    ]}
  >
    <Icon name={data.disponible ? 'check' : 'close'} class="size-2" />
    {data.disponible ? 'Disponible para entrega inmediata' : 'Agotado temporalmente'}
  </p>

  <p class="mt-3 text-lg text-ink">{data.descripcion}</p>

  <div class="mt-4 flex flex-col gap-1.5">
    <Button href={whatsappUrl} external variant="accent" size="lg" fullWidth>
      <Icon name="whatsapp" class="size-2.5" />
      {data.disponible ? 'Consultar por WhatsApp' : 'Consultar disponibilidad por WhatsApp'}
    </Button>
    <Button href="/catalogo/" variant="outline" fullWidth>
      Seguir explorando el catálogo
    </Button>
  </div>

  <ul class="mt-4 space-y-1 border-t border-stone pt-3 text-sm text-taupe">
    {assurances.map((item) => (
      <li class="flex items-center gap-1">
        <Icon name={item.icon} class="size-2.5 text-navy-900" />
        {item.text}
      </li>
    ))}
  </ul>
</div>
