---
import type { HTMLTag } from 'astro/types';

interface Props {
  as?: HTMLTag;
  size?: 'default' | 'narrow';
  class?: string;
}

const { as: Tag = 'div', size = 'default', class: className } = Astro.props;
---

<Tag
  class:list={[
    'mx-auto w-full px-2 sm:px-3 lg:px-4',
    size === 'narrow' ? 'max-w-4xl' : 'max-w-7xl',
    className,
  ]}
>
  <slot />
</Tag>
