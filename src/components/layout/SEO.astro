---
import { SITE } from '@/data/site';
import type { JsonLd } from '@/utils/jsonld';
import { absoluteUrl } from '@/utils/url';

export interface SEOProps {
  title: string;
  description: string;
  /** Absolute path inside /public or an optimized image URL. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'product';
  noindex?: boolean;
  jsonLd?: JsonLd | readonly JsonLd[];
}

type Props = SEOProps;

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = `${SITE.name}: ${SITE.tagline}`,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonical = absoluteUrl(Astro.url.pathname);
const imageUrl = absoluteUrl(image);
const schemas = jsonLd === undefined ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type === 'product' ? 'product' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{schemas.map((schema) => (
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
  />
))}
