---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE } from '@/config/site';
import { absoluteUrl } from '@/utils/url';

export type JsonLd = Record<string, unknown>;

export interface SeoProps {
  title: string;
  description: string;
  /** Local image (optimized to a 1200px JPG) or a path inside /public. */
  image?: ImageMetadata | string | undefined;
  imageAlt?: string | undefined;
  type?: 'website' | 'product';
  noindex?: boolean;
  jsonLd?: JsonLd | readonly JsonLd[];
}

type Props = SeoProps;

const {
  title,
  description,
  image = SITE.defaultOgImage,
  imageAlt = `${SITE.name}: ${SITE.tagline}`,
  type = 'website',
  noindex = false,
  jsonLd,
} = Astro.props;

const fullTitle = title === SITE.name ? title : `${title} | ${SITE.name}`;
const canonical = absoluteUrl(Astro.url.pathname);

let imageUrl: string;
if (typeof image === 'string') {
  imageUrl = absoluteUrl(image);
} else {
  const optimized = await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 });
  imageUrl = absoluteUrl(optimized.src);
}

const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
// Escaping "<" keeps product text from ever closing the <script> tag.
const serialize = (data: JsonLd) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>

<meta property="og:type" content={type === 'product' ? 'product' : 'website'} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={serialize(schema)} />
))}
