---
import { SITE } from '@/data/site';

interface Props {
  class?: string;
  /** Hides the tagline on very small headers. */
  compact?: boolean;
}

const { class: className, compact = false } = Astro.props;
---

<a
  href="/"
  class:list={['inline-flex flex-col items-start leading-none text-white', className]}
  aria-label={`${SITE.name}, ir al inicio`}
>
  <span class="font-display text-2xl tracking-[0.22em]">{SITE.name}</span>
  {!compact && (
    <span class="mt-0.5 text-[0.625rem] font-medium tracking-eyebrow text-noir-300 uppercase">
      {SITE.tagline}
    </span>
  )}
</a>
