---
import {
  CLOSED_DAYS_LABEL,
  CONTACT,
  NAV_ITEMS,
  OPENING_HOURS,
  SITE,
  SOCIAL_LINKS,
} from '@/data/site';
import { buildMailtoHref, formatAddress, getMapLinkUrl, PHONE_HREF } from '@/utils/contact';
import Icon from '../ui/Icon.astro';
import Container from './Container.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
const headingClass = 'eyebrow text-noir-400 font-sans';
const linkClass = 'underline-offset-4 hover:text-white hover:underline';
---

<footer class="on-dark bg-noir-950 text-noir-300" aria-labelledby="pie-titulo">
  <h2 id="pie-titulo" class="sr-only">
    Información de {SITE.name}
  </h2>
  <Container class="grid gap-5 py-6 sm:grid-cols-2 lg:grid-cols-12 lg:gap-4 lg:py-8">
    <div class="sm:col-span-2 lg:col-span-4">
      <Logo />
      <p class="mt-3 max-w-sm text-sm">
        Fragancias 100 % originales, selladas y en decants, para regalar, coleccionar y sorprender.
        Atención personalizada para empresas y clientes particulares en todo El Salvador.
      </p>
      <ul class="mt-3 flex gap-1" aria-label="Redes sociales">
        {SOCIAL_LINKS.map((social) => (
          <li>
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-6 items-center justify-center rounded-full border border-noir-700 text-noir-200 hover:border-white hover:bg-white hover:text-noir-950"
            >
              <Icon name={social.network} class="size-2.5" />
              <span class="sr-only">
                {social.label} de {SITE.name} (abre en una pestaña nueva)
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <nav aria-labelledby="pie-navegacion" class="lg:col-span-2">
      <h3 id="pie-navegacion" class={headingClass}>
        Navegación
      </h3>
      <ul class="mt-2 space-y-1 text-sm">
        {NAV_ITEMS.map((item) => (
          <li>
            <a href={item.href} class={linkClass}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="lg:col-span-3">
      <h3 class={headingClass}>Contacto</h3>
      <address class="mt-2 space-y-1.5 text-sm not-italic">
        <p class="flex items-center gap-1">
          <Icon name="phone" class="size-2" />
          <a href={PHONE_HREF} class={linkClass}>
            {CONTACT.phone.display}
          </a>
        </p>
        <p class="flex items-center gap-1">
          <Icon name="mail" class="size-2" />
          <a href={buildMailtoHref()} class:list={[linkClass, 'break-all']}>
            {CONTACT.email}
          </a>
        </p>
        <p class="flex items-start gap-1">
          <Icon name="map-pin" class="mt-0.5 size-2" />
          <a href={getMapLinkUrl()} target="_blank" rel="noopener noreferrer" class={linkClass}>
            {formatAddress()}
            <span class="sr-only">(ver en Google Maps, abre en una pestaña nueva)</span>
          </a>
        </p>
      </address>
    </div>

    <div class="lg:col-span-3">
      <h3 class={headingClass}>Horario de atención</h3>
      <dl class="mt-2 space-y-1 text-sm">
        {OPENING_HOURS.map((slot) => (
          <div>
            <dt class="text-white">{slot.label}</dt>
            <dd>{slot.hours}</dd>
          </div>
        ))}
        <div>
          <dt class="text-white">{CLOSED_DAYS_LABEL}</dt>
          <dd>Cerrado</dd>
        </div>
      </dl>
    </div>
  </Container>

  <div class="border-t border-noir-800">
    <Container class="flex flex-col gap-1 py-3 text-xs text-noir-400 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © <span data-current-year>{year}</span> {SITE.legalName}. Todos los derechos reservados.
      </p>
      <p>Precios en dólares de los Estados Unidos (USD), sujetos a disponibilidad.</p>
    </Container>
  </div>
</footer>
