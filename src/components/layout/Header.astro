---
import { NAV_ITEMS } from '@/config/site';
import { buildWhatsAppUrl } from '@/utils/whatsapp';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Container from './Container.astro';
import Logo from './Logo.astro';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => {
  if (href.includes('#')) return false;
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
const whatsappUrl = buildWhatsAppUrl();
---

<header class="sticky top-0 z-50 border-b border-stone/80 bg-ivory/95 backdrop-blur-md" data-header>
  <Container class="flex h-9 items-center justify-between gap-2">
    <Logo />

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-4">
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              class="relative py-1 text-sm font-medium text-ink after:absolute after:inset-x-0 after:-bottom-0.5 after:h-0.5 after:origin-left after:scale-x-0 after:bg-gold-500 after:transition-transform after:duration-200 after:ease-out hover:text-navy-700 hover:after:scale-x-100 aria-[current=page]:text-navy-900 aria-[current=page]:after:scale-x-100"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-1">
      <!-- Wrapper owns the responsive display so it never competes with the button's inline-flex. -->
      <div class="hidden sm:block">
        <Button href={whatsappUrl} external variant="accent" size="sm">
          <Icon name="whatsapp" class="size-2" />
          Consultar por WhatsApp
        </Button>
      </div>

      <button
        type="button"
        class="inline-flex size-6 items-center justify-center rounded-md text-navy-900 hover:bg-sand active:bg-stone lg:hidden"
        aria-expanded="false"
        aria-controls="menu-movil"
        aria-label="Abrir menú"
        data-menu-toggle
      >
        <span data-menu-icon="open">
          <Icon name="menu" class="size-3" />
        </span>
        <span data-menu-icon="close" hidden>
          <Icon name="close" class="size-3" />
        </span>
      </button>
    </div>
  </Container>

  <div
    id="menu-movil"
    data-open="false"
    class="invisible absolute inset-x-0 top-full -translate-y-1 border-b border-stone bg-ivory opacity-0 shadow-card-hover transition-[opacity,transform,visibility] duration-200 ease-out data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:opacity-100 lg:hidden"
  >
    <Container class="py-3">
      <nav aria-label="Principal">
        <ul class="flex flex-col">
          {NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class="flex min-h-6 items-center border-b border-stone/70 text-lg font-medium text-ink hover:text-navy-700 aria-[current=page]:font-semibold aria-[current=page]:text-navy-900"
                data-menu-link
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <Button href={whatsappUrl} external variant="accent" fullWidth class="mt-3">
        <Icon name="whatsapp" class="size-2.5" />
        Consultar por WhatsApp
      </Button>
    </Container>
  </div>
</header>

<script>
  import { initMobileMenu } from '../../scripts/menu';
  initMobileMenu();
</script>
