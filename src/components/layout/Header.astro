---
import { NAV_ITEMS } from '@/data/site';
import { isCurrentPath } from '@/utils/url';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Container from './Container.astro';
import Logo from './Logo.astro';

const { pathname } = Astro.url;
const navLinkClass =
  'relative inline-flex min-h-6 items-center text-sm tracking-[0.08em] text-noir-300 xl:tracking-[0.12em] uppercase hover:text-white aria-[current=page]:text-white after:absolute after:inset-x-0 after:bottom-1 after:h-px after:origin-left after:scale-x-0 after:bg-white after:transition-transform after:duration-200 after:ease-out hover:after:scale-x-100 aria-[current=page]:after:scale-x-100';
---

<header class="on-dark sticky top-0 z-50 bg-noir-950 shadow-header" data-site-header>
  <Container class="flex h-9 items-center justify-between gap-3 lg:h-10">
    <Logo collapseTagline />

    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-2 xl:gap-4">
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              class={navLinkClass}
              aria-current={isCurrentPath(item.href, pathname) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="hidden lg:block">
      <Button href="/contacto/" variant="light" class="px-2 whitespace-nowrap xl:px-3">
        Solicitar cotización
      </Button>
    </div>

    <button
      type="button"
      class="-mr-1 inline-flex size-6 items-center justify-center rounded-xs text-white hover:bg-noir-800 active:bg-noir-700 lg:hidden"
      aria-expanded="false"
      aria-controls="menu-movil"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>
        Abrir menú
      </span>
      <span data-menu-icon-open>
        <Icon name="menu" class="size-3" />
      </span>
      <span class="hidden" data-menu-icon-close>
        <Icon name="close" class="size-3" />
      </span>
    </button>
  </Container>

  <div
    id="menu-movil"
    class="absolute inset-x-0 top-full max-h-[calc(100dvh-72px)] -translate-y-1 overflow-y-auto border-t border-noir-800 bg-noir-950 opacity-0 transition-[opacity,transform] duration-200 ease-out data-open:translate-y-0 data-open:opacity-100 lg:hidden"
    hidden
    data-menu-panel
  >
    <Container class="pt-2 pb-4">
      <nav aria-label="Menú móvil">
        <ul class="divide-y divide-noir-800">
          {NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex min-h-7 items-center justify-between font-display text-2xl text-noir-200 hover:text-white aria-[current=page]:text-white"
                aria-current={isCurrentPath(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
                <Icon name="arrow-right" class="size-2" />
              </a>
            </li>
          ))}
        </ul>
      </nav>
      <Button href="/contacto/" variant="light" size="lg" fullWidth class="mt-3">
        Solicitar cotización
      </Button>
    </Container>
  </div>
</header>

<script>
  import { initMenu } from '../../scripts/menu';
  initMenu();
</script>
