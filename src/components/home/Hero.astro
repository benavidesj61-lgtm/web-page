---
import { Picture } from 'astro:assets';
import heroImage from '@/assets/productos/chanel-bleu-de-chanel-frasco.jpg';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Texture from '../ui/Texture.astro';

const HIGHLIGHTS = ['100 % originales', 'Decants de 3, 5 y 10 ml', 'Cotizaciones para empresas'];
---

<section aria-labelledby="hero-titulo" class="on-dark relative isolate overflow-hidden bg-noir-950">
  <Texture priority />
  <Container class="relative grid items-center gap-4 py-6 lg:grid-cols-12 lg:gap-6 lg:py-10">
    <div class="lg:col-span-6">
      <p class="eyebrow text-noir-300">Perfumes & decants originales · El Salvador</p>
      <h1 id="hero-titulo" class="mt-2 text-5xl text-white">
        Fragancias originales que dejan huella
      </h1>
      <p class="mt-3 max-w-xl text-lg text-noir-200">
        Perfumes de diseñador y árabes, sellados o en decants, con asesoría personalizada. Elija el
        regalo perfecto para sus clientes, su equipo o para usted.
      </p>
      <div class="mt-4 flex flex-col gap-2 sm:flex-row">
        <Button href="/catalogo/" variant="light" size="lg">
          Ver catálogo
          <Icon name="arrow-right" class="size-2" />
        </Button>
        <Button href="/contacto/" variant="outline-light" size="lg">
          Contáctanos
        </Button>
      </div>
      <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-1 text-sm text-noir-200">
        {HIGHLIGHTS.map((item) => (
          <li class="flex items-center gap-1">
            <Icon name="check" class="size-2 text-white" />
            {item}
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:col-span-6">
      <Picture
        src={heroImage}
        alt="Frasco de Bleu de Chanel Parfum junto a decants de 3, 5 y 10 ml sobre fondo negro"
        formats={['avif', 'webp']}
        widths={[360, 560, 760, 993]}
        sizes="(min-width: 1280px) 600px, (min-width: 1024px) 46vw, calc(100vw - 32px)"
        width={993}
        height={880}
        loading="eager"
        fetchpriority="high"
        decoding="sync"
        class="h-auto w-full [mask-image:radial-gradient(ellipse_at_center,black_58%,transparent_78%)]"
      />
    </div>
  </Container>
</section>
