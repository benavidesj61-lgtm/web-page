---
import { BENEFITS } from '@/data/home';
import Container from '../layout/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Texture from '../ui/Texture.astro';
---

<section
  id="por-que-elegirnos"
  aria-labelledby="beneficios-titulo"
  class="on-dark relative isolate overflow-hidden bg-noir-950 py-6 lg:py-10"
>
  <Texture />
  <Container class="relative">
    <SectionHeading
      id="beneficios-titulo"
      eyebrow="Por qué elegirnos"
      title="Perfumería de lujo con la confianza que su empresa necesita"
      description="Desde un decant para usted hasta cientos de regalos para su equipo, cuidamos cada detalle."
      dark
    />
    <ul
      class="mt-5 grid gap-px border border-noir-800 bg-noir-800 sm:grid-cols-2 lg:grid-cols-3"
      data-reveal
    >
      {BENEFITS.map((benefit) => (
        <li class="bg-noir-950/90 p-3 lg:p-4">
          <span class="inline-flex size-6 items-center justify-center rounded-full border border-noir-600 text-white">
            <Icon name={benefit.icon} class="size-2.5" />
          </span>
          <h3 class="mt-2 text-xl">{benefit.title}</h3>
          <p class="mt-1 text-noir-300">{benefit.description}</p>
        </li>
      ))}
    </ul>
  </Container>
</section>
