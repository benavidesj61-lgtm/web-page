---
import { buildWhatsAppUrl } from '@/utils/whatsapp';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<section aria-labelledby="cta-titulo" class="py-8 lg:py-12">
  <Container>
    <div
      class="on-dark relative overflow-hidden rounded-lg bg-navy-900 px-3 py-6 text-center sm:px-6 lg:py-8"
      data-reveal
    >
      <div class="mx-auto h-0.5 w-6 bg-gold-500" aria-hidden="true"></div>
      <h2 id="cta-titulo" class="mx-auto mt-3 max-w-2xl text-4xl text-white">
        ¿Busca el regalo perfecto o su nueva fragancia insignia?
      </h2>
      <p class="mx-auto mt-2 max-w-xl text-lg text-mist">
        Cuéntenos para quién es y en qué ocasión se usará. Le recomendamos opciones a su medida, sin
        compromiso.
      </p>
      <div class="mt-4 flex flex-col justify-center gap-2 sm:flex-row">
        <Button href={buildWhatsAppUrl()} external variant="accent" size="lg">
          <Icon name="whatsapp" class="size-2.5" />
          Recibir asesoría por WhatsApp
        </Button>
        <Button href="/catalogo/" variant="outline-light" size="lg">
          Explorar el catálogo
        </Button>
      </div>
    </div>
  </Container>
</section>
