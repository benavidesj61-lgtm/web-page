---
import { FAQ_ITEMS } from '@/data/home';
import Container from '../layout/Container.astro';
import Accordion from '../ui/Accordion.astro';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section
  id="preguntas-frecuentes"
  aria-labelledby="faq-titulo"
  class="border-t border-noir-100 bg-noir-50 py-6 lg:py-10"
>
  <Container class="grid gap-4 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-4">
      <SectionHeading
        id="faq-titulo"
        eyebrow="Preguntas frecuentes"
        title="Resolvemos sus dudas"
        description="Si no encuentra la respuesta que busca, escríbanos y le responderemos personalmente."
      />
      <Button href="/contacto/" variant="outline" class="mt-3">
        Hacer una pregunta
      </Button>
    </div>
    <div class="lg:col-span-8" data-reveal>
      <Accordion items={FAQ_ITEMS} name="preguntas-frecuentes" />
    </div>
  </Container>
</section>
