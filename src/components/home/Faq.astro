---
import { FAQS } from '@/data/home';
import { buildWhatsAppUrl } from '@/utils/whatsapp';
import Container from '../layout/Container.astro';
import Accordion from '../ui/Accordion.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section id="preguntas-frecuentes" aria-labelledby="faq-titulo" class="bg-sand py-8 lg:py-12">
  <Container class="grid gap-5 lg:grid-cols-12 lg:gap-6">
    <div class="lg:col-span-4" data-reveal>
      <SectionHeading id="faq-titulo" eyebrow="Preguntas frecuentes" title="Resolvemos sus dudas" />
      <p class="mt-2 text-taupe">
        ¿No encuentra su respuesta?
        <a
          href={buildWhatsAppUrl('Hola, LE SCENT. Tengo una consulta sobre sus productos.')}
          target="_blank"
          rel="noopener noreferrer"
          class="font-semibold text-navy-900 underline underline-offset-4 hover:text-navy-700"
        >
          Escríbanos por WhatsApp
        </a>
        y le respondemos en minutos.
      </p>
    </div>
    <div class="lg:col-span-8" data-reveal>
      <Accordion items={FAQS} />
    </div>
  </Container>
</section>
