---
import { getFeaturedProducts } from '@/utils/products';
import ProductGrid from '../catalogo/ProductGrid.astro';
import Container from '../layout/Container.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const products = await getFeaturedProducts(4);
---

{products.length > 0 && (
  <section aria-labelledby="destacados-titulo" class="bg-noir-50 py-6 lg:py-10">
    <Container>
      <div class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between">
        <SectionHeading
          id="destacados-titulo"
          eyebrow="Selección LE SCENT"
          title="Productos destacados"
          description="Las fragancias que más recomiendan nuestros asesores, disponibles selladas o en decants."
        />
        <div class="shrink-0">
          <Button href="/catalogo/" variant="link">
            Ver todo el catálogo
            <Icon name="arrow-right" class="size-2" />
          </Button>
        </div>
      </div>
      <div class="mt-4" data-reveal>
        <ProductGrid products={products} label="Productos destacados" />
      </div>
    </Container>
  </section>
)}
