---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import decantsImage from '@/assets/marca/categoria-decants.jpg';
import perfumesImage from '@/assets/marca/categoria-perfumes.jpg';
import setsImage from '@/assets/marca/categoria-sets-corporativos.jpg';
import { CATEGORY_LIST, type CategorySlug } from '@/data/categories';
import Container from '../layout/Container.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';

const CATEGORY_IMAGES: Record<CategorySlug, { src: ImageMetadata; alt: string }> = {
  perfumes: { src: perfumesImage, alt: 'Frasco de perfume original sellado sobre fondo arena' },
  decants: {
    src: decantsImage,
    alt: 'Atomizador de vidrio con decant de perfume y etiqueta LE SCENT',
  },
  'sets-corporativos': {
    src: setsImage,
    alt: 'Estuche azul marino abierto con cinco decants listos para regalar',
  },
};
---

<section aria-labelledby="categorias-titulo" class="bg-sand py-8 lg:py-12">
  <Container>
    <div data-reveal>
      <SectionHeading
        id="categorias-titulo"
        eyebrow="Categorías"
        title="Encuentre la fragancia ideal para cada ocasión"
        description="Desde el frasco completo para su colección hasta el regalo corporativo que sus clientes recordarán."
      />
    </div>
    <ul class="mt-5 grid gap-3 md:grid-cols-3" data-reveal>
      {CATEGORY_LIST.map((category) => {
        const image = CATEGORY_IMAGES[category.slug];
        return (
          <li>
            <Card interactive as="article" class="h-full">
              <div class="overflow-hidden rounded-t-lg">
                <Picture
                  src={image.src}
                  alt={image.alt}
                  formats={['avif', 'webp']}
                  widths={[320, 480, 640, 800]}
                  sizes="(min-width: 1280px) 400px, (min-width: 768px) calc((100vw - 96px) / 3), calc(100vw - 32px)"
                  width={800}
                  height={1000}
                  fit="cover"
                  loading="lazy"
                  decoding="async"
                  class="aspect-4/5 h-auto w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                />
              </div>
              <div class="flex flex-1 flex-col p-3">
                <h3 class="text-2xl">
                  <a
                    href={`/catalogo/?categoria=${category.slug}`}
                    class="after:absolute after:inset-0 after:z-10 focus-visible:outline-none"
                  >
                    {category.name}
                  </a>
                </h3>
                <p class="mt-1 text-taupe">{category.description}</p>
                <span
                  class="mt-auto inline-flex items-center gap-0.5 pt-2 text-sm font-semibold text-navy-900"
                  aria-hidden="true"
                >
                  Ver productos
                  <Icon
                    name="arrow-right"
                    class="size-2 transition-transform duration-200 ease-out group-hover:translate-x-0.5"
                  />
                </span>
              </div>
            </Card>
          </li>
        );
      })}
    </ul>
  </Container>
</section>
