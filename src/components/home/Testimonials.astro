---
import { TESTIMONIALS } from '@/data/home';
import Container from '../layout/Container.astro';
import Icon from '../ui/Icon.astro';
import SectionHeading from '../ui/SectionHeading.astro';
---

<section aria-labelledby="testimonios-titulo" class="py-6 lg:py-10">
  <Container>
    <SectionHeading
      id="testimonios-titulo"
      eyebrow="Testimonios"
      title="Lo que dicen nuestros clientes"
      align="center"
    />
    <ul class="mt-5 grid gap-3 md:grid-cols-3" data-reveal>
      {TESTIMONIALS.map((testimonial) => (
        <li class="flex">
          <figure class="flex flex-col border border-noir-100 bg-white p-3 lg:p-4">
            <Icon name="quote" class="size-4 text-noir-300" />
            <blockquote class="mt-2 flex-1 font-display text-lg leading-relaxed text-noir-900">
              <p>{testimonial.quote}</p>
            </blockquote>
            <figcaption class="mt-3 border-t border-noir-100 pt-2">
              <p class="font-semibold text-noir-950">{testimonial.name}</p>
              <p class="text-sm text-noir-500">{testimonial.role}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </Container>
</section>
