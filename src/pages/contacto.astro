---
import ContactForm from '@/components/contacto/ContactForm.astro';
import ContactInfo from '@/components/contacto/ContactInfo.astro';
import MapEmbed from '@/components/contacto/MapEmbed.astro';
import type { BreadcrumbItem } from '@/components/layout/Breadcrumbs.astro';
import Container from '@/components/layout/Container.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import { CONTACT } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildBreadcrumbSchema, buildLocalBusinessSchema } from '@/utils/jsonld';

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Contacto', href: '/contacto/' },
];
---

<BaseLayout
  title="Contacto y cotizaciones"
  description={`Solicite información o una cotización de perfumes originales, decants y regalos corporativos. Llámenos al ${CONTACT.phone.display} o escríbanos a ${CONTACT.email}.`}
  jsonLd={[buildLocalBusinessSchema(), buildBreadcrumbSchema(breadcrumbs)]}
>
  <PageHeader
    id="contacto-titulo"
    eyebrow="Contacto"
    title="Hablemos de su próxima fragancia"
    description="Asesoría personalizada para compras personales y pedidos corporativos. Cuéntenos qué necesita y le enviaremos una propuesta a la medida."
    breadcrumbs={breadcrumbs}
  />

  <Container class="grid gap-4 py-5 lg:grid-cols-12 lg:gap-6 lg:py-8">
    <div class="lg:col-span-7">
      <ContactForm />
    </div>
    <aside class="lg:col-span-5" aria-label="Datos de contacto">
      <ContactInfo />
    </aside>
  </Container>

  <section aria-labelledby="mapa-titulo" class="pb-6 lg:pb-10">
    <Container>
      <h2 id="mapa-titulo" class="text-3xl">
        Dónde encontrarnos
      </h2>
      <p class="mt-1 text-noir-600">
        Atendemos con cita previa y coordinamos entregas en todo El Salvador.
      </p>
      <div class="mt-3" data-reveal>
        <MapEmbed />
      </div>
    </Container>
  </section>
</BaseLayout>
