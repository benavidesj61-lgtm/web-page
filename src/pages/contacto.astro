---
import ContactForm from '@/components/contacto/ContactForm.astro';
import MapEmbed from '@/components/contacto/MapEmbed.astro';
import Breadcrumbs, { type BreadcrumbItem } from '@/components/layout/Breadcrumbs.astro';
import Container from '@/components/layout/Container.astro';
import Button from '@/components/ui/Button.astro';
import Icon from '@/components/ui/Icon.astro';
import { CONTACT, OPENING_HOURS, SITE, SOCIAL_LINKS } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildWhatsAppUrl } from '@/utils/whatsapp';

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Contacto', href: '/contacto/' },
];
const linkClass = 'font-medium text-navy-900 underline-offset-4 hover:underline';
---

<BaseLayout
  title="Contacto"
  description={`Escríbanos por WhatsApp al ${CONTACT.whatsappDisplay} o complete el formulario. Asesoría en perfumes originales, decants y regalos corporativos en ${CONTACT.address.city}.`}
>
  <section aria-labelledby="contacto-titulo" class="border-b border-stone bg-sand">
    <Container class="py-4 lg:py-6">
      <Breadcrumbs items={breadcrumbs} />
      <h1 id="contacto-titulo" class="mt-3 text-4xl">
        Hablemos de su próxima fragancia
      </h1>
      <p class="mt-2 max-w-2xl text-lg text-taupe">
        Asesoría personalizada para compras personales y pedidos corporativos. Respondemos en
        minutos durante nuestro horario de atención.
      </p>
    </Container>
  </section>

  <Container class="grid gap-4 py-6 lg:grid-cols-12 lg:gap-6 lg:py-8">
    <div class="lg:col-span-7">
      <ContactForm />
    </div>

    <aside class="space-y-3 lg:col-span-5" aria-labelledby="datos-contacto-titulo">
      <h2 id="datos-contacto-titulo" class="sr-only">
        Datos de contacto
      </h2>

      <div class="on-dark rounded-lg bg-navy-900 p-3 text-mist sm:p-4">
        <h3 class="text-2xl text-white">La vía más rápida: WhatsApp</h3>
        <p class="mt-1">Envíenos el nombre del perfume o la ocasión y le ayudamos a elegir.</p>
        <Button href={buildWhatsAppUrl()} external variant="accent" fullWidth class="mt-3">
          <Icon name="whatsapp" class="size-2.5" />
          {CONTACT.whatsappDisplay}
        </Button>
      </div>

      <div class="rounded-lg bg-white p-3 shadow-card sm:p-4">
        <h3 class="font-sans text-lg font-semibold text-navy-900">Otros medios</h3>
        <address class="mt-2 space-y-1.5 not-italic">
          <p class="flex items-center gap-1">
            <Icon name="phone" class="size-2.5 text-gold-700" />
            <a href={CONTACT.phoneHref} class={linkClass}>
              {CONTACT.whatsappDisplay}
            </a>
          </p>
          <p class="flex items-center gap-1">
            <Icon name="mail" class="size-2.5 text-gold-700" />
            <a href={`mailto:${CONTACT.email}`} class={linkClass}>
              {CONTACT.email}
            </a>
          </p>
          <p class="flex items-start gap-1 text-ink">
            <Icon name="map-pin" class="mt-0.5 size-2.5 text-gold-700" />
            <span>
              {CONTACT.address.street}, {CONTACT.address.city}, {CONTACT.address.countryName}
            </span>
          </p>
        </address>

        <h3 class="mt-3 font-sans text-lg font-semibold text-navy-900">Horario de atención</h3>
        <dl class="mt-1 divide-y divide-stone">
          {OPENING_HOURS.map((slot) => (
            <div class="flex justify-between gap-2 py-1">
              <dt class="text-taupe">{slot.label}</dt>
              <dd class="font-medium text-ink">{slot.hours}</dd>
            </div>
          ))}
          <div class="flex justify-between gap-2 py-1">
            <dt class="text-taupe">Domingo</dt>
            <dd class="font-medium text-ink">Cerrado</dd>
          </div>
        </dl>

        <h3 class="mt-3 font-sans text-lg font-semibold text-navy-900">Síganos</h3>
        <ul class="mt-1 flex flex-wrap gap-1">
          {SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-5 items-center gap-1 rounded-full border border-stone px-2 text-sm font-medium text-ink hover:border-navy-900 hover:text-navy-900"
              >
                <Icon name={social.network} class="size-2" />
                {social.label}
                <span class="sr-only">de {SITE.name} (abre en una pestaña nueva)</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </aside>

    <section aria-labelledby="mapa-titulo" class="lg:col-span-12">
      <h2 id="mapa-titulo" class="text-2xl">
        Dónde encontrarnos
      </h2>
      <p class="mt-1 text-taupe">
        Atendemos con cita previa en nuestro showroom y entregamos a domicilio en todo el país.
      </p>
      <div class="mt-3">
        <MapEmbed />
      </div>
    </section>
  </Container>
</BaseLayout>
