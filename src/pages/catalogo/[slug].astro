---
import type { GetStaticPaths } from 'astro';
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import Galeria from '@/components/catalogo/Galeria.astro';
import ProductGrid from '@/components/catalogo/ProductGrid.astro';
import ProductInfo from '@/components/catalogo/ProductInfo.astro';
import Breadcrumbs, { type BreadcrumbItem } from '@/components/layout/Breadcrumbs.astro';
import Container from '@/components/layout/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { CATEGORIES } from '@/data/categories';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buildBreadcrumbSchema, buildProductSchema } from '@/utils/jsonld';
import { formatPrice } from '@/utils/price';
import { getProducts, getProductUrl, getRelatedProducts, type Product } from '@/utils/products';
import { absoluteUrl } from '@/utils/url';

export const getStaticPaths = (async () => {
  const products = await getProducts();
  return products.map((product) => ({ params: { slug: product.data.slug }, props: { product } }));
}) satisfies GetStaticPaths;

interface Props {
  product: Product;
}

const { product } = Astro.props;
const { data } = product;
const { Content } = await render(product);
const category = CATEGORIES[data.categoria];
const related = getRelatedProducts(product, await getProducts());

const breadcrumbs: BreadcrumbItem[] = [
  { label: 'Inicio', href: '/' },
  { label: 'Catálogo', href: '/catalogo/' },
  { label: category.name, href: `/catalogo/?categoria=${category.slug}` },
  { label: data.nombre, href: getProductUrl(product) },
];

const schemaImages = await Promise.all(
  data.imagenes.map(async (image) => {
    const optimized = await getImage({ src: image.src, width: 1200, format: 'jpg', quality: 80 });
    return absoluteUrl(optimized.src);
  }),
);

const [cover] = data.imagenes;
const metaDescription = `${data.descripcion} Precio: ${formatPrice(data.precio)}.`;
---

<BaseLayout
  title={data.nombre}
  description={metaDescription}
  image={cover?.src}
  imageAlt={cover?.alt}
  type="product"
  jsonLd={[buildProductSchema(product, schemaImages), buildBreadcrumbSchema(breadcrumbs)]}
>
  <Container class="py-3 lg:py-4">
    <Breadcrumbs items={breadcrumbs} />
  </Container>

  <Container class="pb-6 lg:pb-8">
    <article class="grid gap-4 lg:grid-cols-12 lg:gap-6">
      <div class="lg:col-span-7">
        <Galeria images={data.imagenes} productName={data.nombre} />
      </div>
      <div class="lg:col-span-5">
        <div class="lg:sticky lg:top-12">
          <ProductInfo product={product} />
        </div>
      </div>

      <div class="grid gap-4 border-t border-stone pt-4 lg:col-span-12 lg:grid-cols-12 lg:gap-6">
        <section aria-labelledby="descripcion-titulo" class="lg:col-span-7">
          <h2 id="descripcion-titulo" class="text-2xl">
            Descripción
          </h2>
          <div class="prose-lescent mt-2 text-lg">
            <Content />
          </div>
          {data.etiquetas && data.etiquetas.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-1" aria-label="Etiquetas">
              {data.etiquetas.map((tag) => (
                <li>
                  <Badge>{tag}</Badge>
                </li>
              ))}
            </ul>
          )}
        </section>

        {data.caracteristicas && data.caracteristicas.length > 0 && (
          <section aria-labelledby="caracteristicas-titulo" class="lg:col-span-5">
            <h2 id="caracteristicas-titulo" class="text-2xl">
              Características
            </h2>
            <ul class="mt-2 divide-y divide-stone rounded-lg bg-white px-2 shadow-card">
              {data.caracteristicas.map((feature) => (
                <li class="py-1.5 text-ink">{feature}</li>
              ))}
            </ul>
            {data.sku && <p class="mt-2 text-sm text-taupe">SKU: {data.sku}</p>}
          </section>
        )}
      </div>
    </article>
  </Container>

  {related.length > 0 && (
    <section aria-labelledby="relacionados-titulo" class="border-t border-stone bg-sand py-8">
      <Container>
        <div data-reveal>
          <SectionHeading
            id="relacionados-titulo"
            eyebrow={category.name}
            title="También le puede interesar"
          />
        </div>
        <div class="mt-4" data-reveal>
          <ProductGrid products={related} />
        </div>
      </Container>
    </section>
  )}
</BaseLayout>
