---
import Container from '@/components/layout/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE } from '@/config/site';
---

<BaseLayout title={SITE.name} description={SITE.description}>
  <Container class="py-8">
    <h1 class="text-5xl">LE SCENT</h1>
    <div class="mt-3 flex flex-wrap gap-2">
      <Button>Primario</Button>
      <Button variant="accent">Acento</Button>
      <Button variant="outline">Contorno</Button>
      <Button disabled>Deshabilitado</Button>
      <Badge variant="new">Nuevo</Badge>
      <Badge variant="sale">Oferta</Badge>
      <Badge variant="soldout">Agotado</Badge>
    </div>
  </Container>
</BaseLayout>
