---
import Container from '@/components/layout/Container.astro';
import Badge from '@/components/ui/Badge.astro';
import Button from '@/components/ui/Button.astro';
import { SITE } from '@/data/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Perfumes y decants originales en El Salvador" description={SITE.description}>
  <Container class="py-8">
    <h1 class="text-5xl">LE SCENT</h1>
    <div class="mt-3 flex flex-wrap gap-2">
      <Button href="/catalogo/">Ver catálogo</Button>
      <Button href="/contacto/" variant="outline">
        Contáctanos
      </Button>
      <Badge variant="new">Nuevo</Badge>
      <Badge variant="sale">Oferta</Badge>
      <Badge variant="soldout">Agotado</Badge>
    </div>
  </Container>
</BaseLayout>
